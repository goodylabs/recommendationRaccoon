{
  "name": "@goodylabs/raccoon",
  "author": "goodylabs",
  "description": "A Collaborative Filtering Recommendation Engine for Node.js utilizing Redis",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/goodylabs/recommendationRaccoon.git"
  },
  "scripts": {
    "build": "rm -rf build; tsc -p tsconfig.build.json",
    "test": "NODE_ENV=test jest --runInBand",
    "test:cov": "NODE_ENV=test jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "ioredis": "^4.14.1",
    "lodash": "^4.17.15",
    "p-map": "^3.0.0"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "recommend",
    "recommended",
    "recommendation",
    "engine",
    "collaborative",
    "filtering",
    "middleware",
    "redis"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/goodylabs/recommendationRaccoon/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/ioredis": "^4.14.3",
    "@types/jest": "^29.2.0",
    "@types/lodash": "^4.14.149",
    "@types/node": "^22.20.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "^29.2.1",
    "prettier": "^3.2.5",
    "ts-jest": "^29.0.3",
    "typescript": "^5",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "yarn@4.0.0",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}
